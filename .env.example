# Vercel Connect connector UIDs. The deploy button provisions and sets both;
# for manual setup, create them with `vercel connect create` and paste the UIDs.
GITHUB_CONNECTOR=github/foreman-agent
LINEAR_CONNECTOR=linear/foreman-agent

# The repository the factory works on. Must be an existing GitHub repository
# in owner/repo format, and the GitHub App behind GITHUB_CONNECTOR must be
# installed with access to it: a station sandbox clones this repository on its
# first session and fails with "Cannot access <owner/repo>" when the app
# cannot reach it. A missing or malformed value fails discovery with a clear
# error.
FACTORY_REPO=acme/widgets

# Optional: runs inside the station sandbox's clone once per session, so a
# session starts with dependencies installed and the repo's checks runnable.
# FACTORY_SETUP_COMMAND="pnpm install"

# Optional overrides; every one has a sensible default.
# FACTORY_LABEL="factory"            # the label that hands an issue to the factory
# FACTORY_BRANCH_PREFIX="factory/"   # branch prefix marking the factory's own PRs
# FACTORY_BOT_NAME=""                # @mention name; defaults to the GitHub App's own slug via the connector

# ---------------------------------------------------------------------------
# Railway (FACTORY_PLATFORM=railway). Replaces Connect, Blob and Vercel OIDC;
# the Vercel variables above are then unused. See docs/RAILWAY.md.
# ---------------------------------------------------------------------------
# FACTORY_PLATFORM=railway

# Your own GitHub App, installed on FACTORY_REPO with contents, issues, pull
# requests and checks write access, webhook URL https://<domain>/eve/v1/github.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=            # PEM; literal \n sequences are accepted
# GITHUB_WEBHOOK_SECRET=

# Railway Bucket, mapped from the bucket's variable references.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false          # true only for buckets that show path-style URLs

# Station sandboxes stay on Vercel Sandbox (its egress firewall keeps the git
# token out of the sandbox). A Vercel access token scoped to one team.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# Models: an AI Gateway key, or a provider key with a direct provider model.
# AI_GATEWAY_API_KEY=

# Route auth for /eve/ (eve remote connect, operator clients).
# FACTORY_ROUTE_USER=factory
# FACTORY_ROUTE_PASSWORD=

# Optional: Linear, with your own Linear app.
# LINEAR_AGENT_ACCESS_TOKEN=
# LINEAR_WEBHOOK_SECRET=
